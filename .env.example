DATABASE_URL=postgresql+psycopg://pulsewatch:pulsewatch@db:5432/pulsewatch
POSTGRES_PASSWORD=pulsewatch
API_KEY=replace-with-a-long-random-secret
ALLOW_PRIVATE_TARGETS=false
CHECK_TIMEOUT_SECONDS=8
WORKER_POLL_SECONDS=2

# Optional outbound email alerts. Configure SMTP to enable email delivery.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true
ALERT_TIMEOUT_SECONDS=8
ALERT_LEASE_SECONDS=60
ALERT_MAX_ATTEMPTS=5

ENVIRONMENT=development
CHECK_LEASE_SECONDS=60

# Public HTTPS deployment (Phase 5)
PULSEWATCH_DOMAIN=monitor.example.com
